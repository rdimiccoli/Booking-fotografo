# Configurazione Google Calendar
GOOGLE_CLIENT_ID=inserisci_il_tuo_client_id
GOOGLE_CLIENT_SECRET=inserisci_il_tuo_client_secret
GOOGLE_REFRESH_TOKEN=inserisci_il_tuo_refresh_token
GOOGLE_CALENDAR_ID=inserisci_il_tuo_calendar_id

# Configurazione Resend (email)
RESEND_API_KEY=re_123456789_inserisci_la_tua_api_key_resend
NOTIFY_EMAIL=il_tuo_email_per_le_notifiche@gmail.com

# Altre configurazioni
NODE_ENV=development